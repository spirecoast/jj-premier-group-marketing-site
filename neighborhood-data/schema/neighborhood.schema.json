{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neighborhood.schema.json",
  "title": "Neighborhood",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_id",
    "slug",
    "name",
    "aliases",
    "level",
    "parentSlug",
    "market",
    "bradentonArea",
    "jurisdiction",
    "county",
    "zips",
    "lat",
    "lng",
    "type",
    "developer",
    "activeBuilders",
    "yearsBuilt",
    "homeTypes",
    "homeCount",
    "gated",
    "ageRestricted",
    "hoa",
    "cdd",
    "amenities",
    "waterAccess",
    "zonedSchools",
    "evacuationZone",
    "status",
    "officialUrl",
    "description",
    "research",
    "sources",
    "notes"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^neighborhood-[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "enum": [
        "area",
        "community",
        "enclave"
      ]
    },
    "parentSlug": {
      "type": [
        "string",
        "null"
      ]
    },
    "market": {
      "enum": [
        "lakewood-ranch",
        "sarasota",
        "bradenton"
      ]
    },
    "bradentonArea": {
      "type": "boolean"
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "county": {
      "enum": [
        "Manatee",
        "Sarasota",
        null
      ]
    },
    "zips": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{5}$"
      }
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 26.8,
      "maximum": 27.8
    },
    "lng": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -83.0,
      "maximum": -81.9
    },
    "type": {
      "enum": [
        "downtown district",
        "island",
        "historic district",
        "neighborhood",
        "master-planned community",
        "village",
        "golf community",
        "gated community",
        "condo community",
        "subdivision",
        null
      ]
    },
    "developer": {
      "type": [
        "string",
        "null"
      ]
    },
    "activeBuilders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "yearsBuilt": {
      "type": [
        "string",
        "null"
      ]
    },
    "homeTypes": {
      "type": "array",
      "items": {
        "enum": [
          "single-family",
          "villa",
          "paired villa",
          "townhome",
          "condominium",
          "carriage home",
          "coach home",
          "estate",
          "manufactured"
        ]
      }
    },
    "homeCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "gated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ageRestricted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hoa": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cdd": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waterAccess": {
      "enum": [
        "gulf-front",
        "bayfront",
        "canal",
        "river",
        "lake",
        "none",
        null
      ]
    },
    "zonedSchools": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "elementary",
        "middle",
        "high",
        "checkedAddress",
        "sourceUrl",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "elementary": {
          "type": [
            "string",
            "null"
          ]
        },
        "middle": {
          "type": [
            "string",
            "null"
          ]
        },
        "high": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedAddress": {
          "type": "string"
        },
        "checkedPoint": {
          "type": "object",
          "required": [
            "lat",
            "lng"
          ],
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        },
        "sourceUrl": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evacuationZone": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "none",
        null
      ]
    },
    "status": {
      "enum": [
        "established",
        "selling",
        "coming-soon",
        "built-out",
        null
      ]
    },
    "officialUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "research": {
      "enum": [
        "full",
        "registry-only"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "supports",
          "checked",
          "sourceDate"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "supports": {
            "type": "string"
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sourceDate": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}