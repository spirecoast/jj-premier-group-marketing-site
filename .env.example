# =============================================================================
# Phase 1 — required to boot
# =============================================================================

# Clerk (auth) — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Override Clerk's default sign-in URL to our in-app catch-all route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/login"
# Sign-up is invite-only — point to no-access so accidental sign-ups land
# on the "you're not on the team" page rather than creating real accounts.
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/no-access"
# After sign-in / sign-out destinations
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/portal"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/auth/no-access"

# Supabase (DB + Storage + Realtime — auth is handled by Clerk)
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Drizzle / postgres-js — use the Supabase pooled connection string
# Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Resend — transactional email
RESEND_API_KEY="re_your_key"
# Verified sender (must match a domain you've verified in Resend)
RESEND_FROM_EMAIL="[email protected]"
# Internal recipient for new-lead notifications (placeholder — swap for real inbox)
[email protected]"

# Site URL — used in absolute links and email templates
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Marketing-email unsubscribe token signing key. Min 32 chars.
# Generate one with: `openssl rand -base64 48`
UNSUBSCRIBE_SECRET=""


# =============================================================================
# Public site — content (Sanity) and lead capture (Follow Up Boss)
# See docs/handoff/integrations/sanity.md and follow-up-boss.md
# =============================================================================

# --- Sanity ---------------------------------------------------------------
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty and the site renders its built-in
# sample content (lib/content/seed). Set it and every page reads from Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Date-pinned API version. Never vX in production.
NEXT_PUBLIC_SANITY_API_VERSION="2026-09-01"
# Server only. Editor token for mutations, the archive cron and the seed import.
SANITY_WRITE_TOKEN=""
# Server only. Viewer token for draft previews (Presentation tool). Falls back to the write token.
SANITY_VIEWER_TOKEN=""
# Shared secret for the GROQ-powered webhook -> POST /api/revalidate
SANITY_REVALIDATE_SECRET=""

# --- Follow Up Boss --------------------------------------------------------
# Register the system first: https://apps.followupboss.com/system-registration
FUB_API_KEY=""
FUB_SYSTEM=""
FUB_SYSTEM_KEY=""
# Marketing name of the lead source. Bare domain, no www.
FUB_LEAD_SOURCE="jjpremiergroup.com"
# Pixel id from Admin > Integrations > Follow Up Boss Pixel. Form capture MUST be off there.
NEXT_PUBLIC_FUB_PIXEL_ID=""
# Where 204 (archived lead flow) and delivery-failure alerts go. Falls back to TEAM_NOTIFY_EMAIL.
LEAD_ALERT_EMAIL=""

# --- Map tiles (neighborhood explorer) -------------------------------------
# MapLibre renders; tiles come from MapTiler when this key is set (free tier
# 100k map loads/month, then paid; register the site domain as an allowed
# origin in MapTiler). Empty = OpenFreeMap, free with no key. Same brand style either way.
NEXT_PUBLIC_MAPTILER_KEY=""

# --- Analytics (Plausible) ---------------------------------------------------
# The site's domain as registered in Plausible, no protocol. Empty = no script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Only for a self-hosted Plausible; defaults to https://plausible.io.
NEXT_PUBLIC_PLAUSIBLE_HOST=""

# Set to "true" on previews and until launch sign-off so the site is not indexed.
NEXT_PUBLIC_ROBOTS_NOINDEX=""

# --- Scheduled jobs ---------------------------------------------------------
# Bearer secret for /api/cron/archive-events (Vercel Cron sends it automatically when set).
CRON_SECRET=""


# =============================================================================
# Coming online in later phases (kept here as the running list per ARCHITECTURE.md §3)
# Uncomment as each phase lands.
# =============================================================================

# --- Anthropic — never hardcode model IDs; reference logical roles only ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_TRIAGE=
# ANTHROPIC_MODEL_STANDARD=
# ANTHROPIC_MODEL_DEEP=

# --- Inngest (background jobs — welcome series, failsafes, etc.) ---
# Local dev: leave unset and run `npx inngest-cli dev` against /api/inngest.
# Prod: set both keys from the Inngest dashboard.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- MLS / IDX (Phase 3 — Showcase IDX, Stellar MLS) ---
# SHOWCASE_IDX_API_KEY=

# --- Property data (Phase 4) ---
# ATTOM_API_KEY=
# GREATSCHOOLS_API_KEY=
# FIRST_STREET_API_KEY=
# WALKSCORE_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Mortgage rates (Phase 4) ---
# MORTGAGE_RATES_API_KEY=

# --- Marketing email + sequences (Phase 2/8) ---
# LOOPS_API_KEY=
# CUSTOMER_IO_SITE_ID=
# CUSTOMER_IO_API_KEY=

# --- SMS — requires 10DLC registration (Phase 6) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_PHONE_NUMBER=

# --- Phone tracking (Phase 1/2) ---
# CALLRAIL_API_KEY=
# CALLRAIL_ACCOUNT_ID=

# --- Image hosting (Phase 3) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Video hosting (Phase 8) ---
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# --- Analytics (Phase 1/2) ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Error monitoring (Phase 1/2) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- LLM observability (Phase 7) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# --- Document archive — 7yr WORM (Phase 6) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_COMPLIANCE_BUCKET=

# --- Scheduling (Phase 1/2) ---
# CALCOM_API_KEY=

# --- Document signing (Phase 5+) ---
# DOTLOOP_API_KEY=

# Where "See our current listings" points until an MLS feed is licensed (the team's
# Coldwell Banker listings page). Empty hides the link.
NEXT_PUBLIC_LISTINGS_URL=""
# The sample listings in lib/content/seed stay off the site unless this is "true".
NEXT_PUBLIC_SHOW_SAMPLE_LISTINGS=""
